# FORTIS VAULT - BACKEND CONFIGURATION

PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# PostgreSQL
DATABASE_URL=postgresql://username:password@hostname/database?sslmode=verify-full

# Resend
BREVO_API_KEY=replace_with_your_brevo_api_key
EMAIL_FROM=your_verified_sender_email@example.com

# Frontend
CORS_ORIGIN=http://localhost:5173

